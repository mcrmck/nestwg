#compdef nestwg

local -a commands
commands=(
	'help:show general or command-specific help'
  'validate:validate a chain and its WireGuard files'
  'plan:print the pinned executable plan'
  'up:expose a nested VPN to host traffic'
  'down:remove host routing and the nested VPN'
  'status:show live chain status'
  'diagnose:check VPN and protected-route health'
  'doctor:check Linux networking prerequisites'
  'recover:remove process-free orphan VPN resources'
  'version:print the version'
)

_arguments -C \
  '1:command:->command' \
  '*::argument:->args'

case "$state" in
  command)
    _describe command commands
    ;;
  args)
    case "$words[2]" in
      validate|plan)
        _files -g '*.yaml'
        ;;
      up)
        _arguments '(-v --verbose)'{-v,--verbose}'[print lifecycle progress]' '--wait[wait for handshakes]:duration:' '--default-route[route supported address families through the VPN]' '*--route[route a destination through the VPN]:CIDR:' '--isolated[construct without host routing]' '*:chain file or name:_files -g "*.yaml"'
        ;;
      down)
        _arguments '(-v --verbose)'{-v,--verbose}'[print lifecycle progress]' '*:chain file or name:_files -g "*.yaml"'
        ;;
    esac
    ;;
esac
